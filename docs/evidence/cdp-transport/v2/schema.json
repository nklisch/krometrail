{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransportEvidenceV2",
  "type": "object",
  "properties": {
    "browser": {
      "$ref": "#/$defs/BrowserEvidence"
    },
    "candidate": {
      "$ref": "#/$defs/CandidateIdentity"
    },
    "candidate_contract": {
      "description": "Required on decisive reports; optional for candidate-neutral unit evidence.",
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateContractEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "configuration": {
      "$ref": "#/$defs/GateConfiguration"
    },
    "environment": {
      "$ref": "#/$defs/SanitizedEnvironment"
    },
    "fixture": {
      "$ref": "#/$defs/FixtureEvidence"
    },
    "gate_provenance": {
      "$ref": "#/$defs/GateProvenance"
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GateResult"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "source",
    "environment",
    "browser",
    "fixture",
    "configuration",
    "gate_provenance",
    "gates",
    "limitations"
  ],
  "$defs": {
    "BrowserEvidence": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "product",
        "protocol",
        "revision"
      ]
    },
    "CandidateContractEvidence": {
      "description": "Results and the exact observed wire projection are inseparable: a report that uses scripted\ncandidate evidence must carry the material needed to independently recompute every summary.",
      "type": "object",
      "properties": {
        "fixture_sha256": {
          "type": "string"
        },
        "results": {
          "$ref": "#/$defs/CandidateContractResults"
        },
        "trace": {
          "$ref": "#/$defs/CandidateContractTrace"
        },
        "trace_observations": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "trace_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fixture_sha256",
        "trace_sha256",
        "trace_observations",
        "results",
        "trace"
      ]
    },
    "CandidateContractResults": {
      "type": "object",
      "properties": {
        "runtime": {
          "$ref": "#/$defs/CandidateRuntimeAssertions"
        },
        "wire": {
          "$ref": "#/$defs/CandidateWireResults"
        }
      },
      "additionalProperties": false,
      "required": [
        "wire",
        "runtime"
      ]
    },
    "CandidateContractTrace": {
      "description": "Canonical material from which every candidate-contract summary is derived.",
      "type": "object",
      "properties": {
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalProtocolFixture"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalWireObservation"
          }
        },
        "runtime_assertions": {
          "$ref": "#/$defs/CandidateRuntimeAssertions"
        }
      },
      "additionalProperties": false,
      "required": [
        "fixtures",
        "observations",
        "runtime_assertions"
      ]
    },
    "CandidateIdentity": {
      "type": "object",
      "properties": {
        "checksum": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "checksum"
      ]
    },
    "CandidateRuntimeAssertions": {
      "description": "Assertions exposed by the candidate runtime after the socket closes. These are deliberately\nclassified separately because a cdpkit close-status API is not a wire observation.",
      "type": "object",
      "properties": {
        "pending_calls_closed": {
          "type": "boolean"
        },
        "subscriptions_closed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "pending_calls_closed",
        "subscriptions_closed"
      ]
    },
    "CandidateWireResults": {
      "description": "Results that can be proved from the scripted WebSocket observations alone.\n\nKeeping these fields in a wire-specific type prevents adapter convenience APIs from being\naccidentally presented as protocol evidence. Values are projected from recorded envelopes,\nnot from scenario expectations.",
      "type": "object",
      "properties": {
        "connection_survived": {
          "type": "boolean"
        },
        "detach_during_pending": {
          "type": "boolean"
        },
        "drift_fixtures": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "drift_methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_before_response": {
          "type": "boolean"
        },
        "reconnect_connections": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "routing_commands": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "routing_cross_delivery": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "routing_events": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sessions_rebuilt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "socket_closed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "drift_fixtures",
        "drift_methods",
        "connection_survived",
        "routing_commands",
        "routing_events",
        "routing_cross_delivery",
        "event_before_response",
        "detach_during_pending",
        "socket_closed",
        "reconnect_connections",
        "sessions_rebuilt"
      ]
    },
    "CanonicalProtocolFixture": {
      "description": "The small, stable fixture projection retained with decisive evidence.\n\nThe projection intentionally stores parsed method and params rather than filesystem paths or\nraw runner output. Its ordered serialization is the fixture digest input, so validation can\nrecompute both the claims and the digest from the report itself.",
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "params": true
      },
      "additionalProperties": false,
      "required": [
        "name",
        "method",
        "params"
      ]
    },
    "CanonicalWireObservation": {
      "description": "A sanitized wire projection, not an unbounded raw log. Sequence and connection numbers are\nretained because ordering and reconnect assertions cannot be reconstructed from summaries.",
      "type": "object",
      "properties": {
        "connection": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/CanonicalWireObservationKind"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": true,
        "request_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "sequence",
        "connection",
        "kind",
        "params"
      ]
    },
    "CanonicalWireObservationKind": {
      "type": "string",
      "enum": [
        "command",
        "response",
        "event",
        "connection_closed"
      ]
    },
    "FixtureEvidence": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ]
    },
    "GateConfiguration": {
      "type": "object",
      "properties": {
        "hard_stop_seconds": {
          "description": "Canonical decisive value: 120 seconds. This is the strict upper bound for observed\ncapture and handoff elapsed measurements; it is not derived from an assumed frame rate.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "minimum_frames": {
          "description": "Canonical decisive value: 1,000 frames.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "minimum_seconds": {
          "description": "Canonical decisive value: 60 seconds.",
          "type": "number",
          "format": "double"
        },
        "saturation_attempts": {
          "description": "Canonical decisive value: 100 attempts.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "saturation_seconds": {
          "description": "Canonical decisive value: 10 seconds.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum_seconds",
        "minimum_frames",
        "saturation_seconds",
        "saturation_attempts",
        "hard_stop_seconds"
      ]
    },
    "GateProvenance": {
      "type": "object",
      "properties": {
        "configuration_sha256": {
          "description": "Digest of the exact serialized GateConfiguration used by the runner.",
          "type": "string"
        },
        "implementation_revision": {
          "description": "The immutable source revision of the gate implementation used by the runner.",
          "type": "string"
        },
        "source_attestation": {
          "description": "Deterministic attestation of every tracked input to the qualification gate.\nThis is optional only for non-decisive failure/unit evidence.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAttestation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "implementation_revision",
        "configuration_sha256"
      ]
    },
    "GateResult": {
      "type": "object",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpikeError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/TransportGateId"
        },
        "measurements": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "summary",
        "measurements"
      ]
    },
    "GateStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not_run"
      ]
    },
    "QualificationStage": {
      "description": "Named phases make a timeout actionable instead of collapsing the whole gate into one\nundifferentiated deadline. This is spike infrastructure state, not a production lifecycle.",
      "type": "string",
      "enum": [
        "initializing",
        "candidate_contract",
        "candidate_connect",
        "candidate_routing",
        "candidate_drift",
        "candidate_screencast",
        "candidate_lifecycle",
        "candidate_rebuild",
        "chrome_startup",
        "browser_connect",
        "target_setup",
        "typed_probe",
        "routing_subscriptions",
        "protocol_drift",
        "screencast_start",
        "screencast_frame_receive",
        "screencast_ack",
        "disconnect",
        "rebuild",
        "evidence"
      ]
    },
    "SanitizedEnvironment": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture"
      ]
    },
    "SourceAttestation": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceFileAttestation"
          }
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "digest",
        "files"
      ]
    },
    "SourceFileAttestation": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    },
    "SourceIdentity": {
      "type": "object",
      "properties": {
        "git_revision": {
          "type": "string"
        },
        "protocol_revision": {
          "type": "string"
        },
        "rust_version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "git_revision",
        "protocol_revision",
        "rust_version"
      ]
    },
    "SpikeError": {
      "description": "Errors deliberately exposed by the disposable qualification boundary.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/SpikeErrorCode"
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransportGateId"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualificationStage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "SpikeErrorCode": {
      "type": "string",
      "enum": [
        "connect",
        "command",
        "protocol",
        "routing",
        "subscription_closed",
        "disconnected",
        "deadline",
        "invariant",
        "io",
        "evidence"
      ]
    },
    "TransportGateId": {
      "type": "string",
      "enum": [
        "deterministic-routing",
        "typed-domains",
        "flat-session-isolation",
        "raw-browser-command",
        "raw-session-command",
        "named-raw-event-params",
        "protocol-drift-survival",
        "sustained-screencast",
        "prompt-acknowledgement",
        "bounded-handoff-saturation",
        "bounded-memory-proxy",
        "disconnect-cleanup",
        "explicit-reconnect-rebuild"
      ]
    }
  }
}