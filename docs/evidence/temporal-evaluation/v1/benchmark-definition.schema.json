{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkDefinition",
  "type": "object",
  "properties": {
    "benchmark_id": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaseDefinition"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceCondition"
      }
    },
    "device_scale_factor_milli": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "duration_ms": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0
      }
    },
    "fixture": {
      "$ref": "#/$defs/FixtureIdentity"
    },
    "input_identities": {
      "$ref": "#/$defs/InputIdentities"
    },
    "matrix": {
      "$ref": "#/$defs/MatrixDefinition"
    },
    "prompts": {
      "$ref": "#/$defs/PromptSet"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "scoring": {
      "$ref": "#/$defs/ScoringVocabulary"
    },
    "viewport_height": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "viewport_width": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "fixture",
    "viewport_width",
    "viewport_height",
    "device_scale_factor_milli",
    "duration_ms",
    "cases",
    "matrix",
    "conditions",
    "prompts",
    "scoring",
    "input_identities"
  ],
  "$defs": {
    "AnswerKind": {
      "type": "string",
      "enum": [
        "interpretation",
        "debugging"
      ]
    },
    "ArtifactContract": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "algorithm",
        "version"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "final_screenshot",
        "uniform_storyboard",
        "change_aware_storyboard",
        "before_during_after",
        "difference_map",
        "temporal_debug_bundle",
        "source_frame",
        "region_filmstrip"
      ]
    },
    "CaseDefinition": {
      "type": "object",
      "properties": {
        "affected_region": {
          "description": "The exact captured-viewport-pixel ROI consumed by localization scoring.",
          "$ref": "#/$defs/Rect"
        },
        "anchor_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "defect_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "$ref": "#/$defs/CaseFamily"
        },
        "final_state_id": {
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/CaseIntent"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhaseDefinition"
          }
        },
        "timing": {
          "$ref": "#/$defs/TimingDefinition"
        },
        "variant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "intent",
        "variant",
        "anchor_id",
        "timing",
        "phases",
        "affected_region",
        "final_state_id"
      ]
    },
    "CaseFamily": {
      "type": "string",
      "enum": [
        "movement_reversal",
        "flicker",
        "transient_layout",
        "dom_opaque_motion",
        "stable_control"
      ]
    },
    "CaseIntent": {
      "type": "string",
      "enum": [
        "defect",
        "intentional"
      ]
    },
    "ConditionId": {
      "type": "string",
      "enum": [
        "A-final-screenshot",
        "B-uniform-storyboard",
        "C-change-aware-storyboard",
        "D-temporal-bundle",
        "E-progressive-source"
      ]
    },
    "ConditionInput": {
      "type": "string",
      "enum": [
        "final_screenshot",
        "current_page_observation",
        "uniform_source_storyboard",
        "change_aware_source_storyboard",
        "before_during_after_composite",
        "difference_map",
        "capture_summary",
        "evidence_references",
        "source_frame_retrieval",
        "region_filmstrip_retrieval"
      ]
    },
    "DurationMode": {
      "type": "string",
      "enum": [
        "defect_interval",
        "transition_interval",
        "observation_window"
      ]
    },
    "EvaluationStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "blocked",
        "skipped"
      ]
    },
    "EvidenceCondition": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactContract"
          }
        },
        "condition_id": {
          "$ref": "#/$defs/ConditionId"
        },
        "initial_source_frame_tile_limit": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionInput"
          }
        },
        "prompt_id": {
          "$ref": "#/$defs/PromptId"
        },
        "retrieval_budget": {
          "$ref": "#/$defs/RetrievalBudget"
        },
        "scoring_dimension_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoringDimensionId"
          }
        },
        "source_interval_policy": {
          "$ref": "#/$defs/SourceIntervalPolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "condition_id",
        "source_interval_policy",
        "inputs",
        "artifacts",
        "initial_source_frame_tile_limit",
        "retrieval_budget",
        "prompt_id",
        "scoring_dimension_ids"
      ]
    },
    "FixtureFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    },
    "FixtureIdentity": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureFile"
          }
        },
        "name": {
          "type": "string"
        },
        "root_relative_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "root_relative_path",
        "files"
      ]
    },
    "InputIdentities": {
      "type": "object",
      "properties": {
        "conditions_sha256": {
          "type": "string"
        },
        "matrix_sha256": {
          "type": "string"
        },
        "prompts_sha256": {
          "type": "string"
        },
        "scoring_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "matrix_sha256",
        "conditions_sha256",
        "prompts_sha256",
        "scoring_sha256"
      ]
    },
    "MatrixDefinition": {
      "type": "object",
      "properties": {
        "capture_order": {
          "$ref": "#/$defs/MatrixOrder"
        },
        "capture_repetitions": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "interpretation_order": {
          "$ref": "#/$defs/MatrixOrder"
        },
        "interpretation_repetitions": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "required_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseFamily"
          }
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stable_controls_required": {
          "type": "boolean"
        },
        "status_rules": {
          "$ref": "#/$defs/StatusRules"
        },
        "supplemental_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseFamily"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "seed",
        "capture_repetitions",
        "interpretation_repetitions",
        "capture_order",
        "interpretation_order",
        "required_families",
        "supplemental_families",
        "stable_controls_required",
        "status_rules"
      ]
    },
    "MatrixOrder": {
      "type": "string",
      "enum": [
        "family_case_duration_repetition",
        "seeded_fisher_yates"
      ]
    },
    "PhaseBoundary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zero"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "offset_ms"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "offset_plus_duration_ms"
            },
            "offset_ms": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "offset_ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "end"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PhaseDefinition": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/PhaseBoundary"
        },
        "id": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/PhaseBoundary"
        },
        "state_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "state_id",
        "start",
        "end"
      ]
    },
    "PromptId": {
      "type": "string",
      "enum": [
        "interpretation-v1",
        "debugging-v1"
      ]
    },
    "PromptSet": {
      "type": "object",
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PromptTemplate"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "templates"
      ]
    },
    "PromptTemplate": {
      "type": "object",
      "properties": {
        "answer_kind": {
          "$ref": "#/$defs/AnswerKind"
        },
        "id": {
          "$ref": "#/$defs/PromptId"
        },
        "sha256": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "task_prompt": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "answer_kind",
        "system_prompt",
        "task_prompt",
        "sha256"
      ]
    },
    "Rect": {
      "description": "Half-open affected extent in fixed 800x450 viewport pixels, origin at the top-left; not stage-relative or canvas-local coordinates.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Extent height in viewport pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "description": "Extent width in viewport pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "description": "Horizontal viewport-pixel origin of the half-open rectangle.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "description": "Vertical viewport-pixel origin of the half-open rectangle.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RetrievalBudget": {
      "type": "object",
      "properties": {
        "region_filmstrips": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "source_frame_requests": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "source_frames_per_request": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "source_frame_requests",
        "source_frames_per_request",
        "region_filmstrips"
      ]
    },
    "ScoringDimension": {
      "type": "object",
      "properties": {
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contributes_to_thesis": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/ScoringDimensionId"
        },
        "requires_ground_truth": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "allowed_values",
        "requires_ground_truth",
        "contributes_to_thesis"
      ]
    },
    "ScoringDimensionId": {
      "type": "string",
      "enum": [
        "transient_defect_identification",
        "state_order",
        "affected_region",
        "motion_behavior",
        "gap_uncertainty",
        "stable_control_false_positive"
      ]
    },
    "ScoringVocabulary": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScoringDimension"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "dimensions"
      ]
    },
    "SourceIntervalPolicy": {
      "type": "string",
      "enum": [
        "same_captured_source_interval"
      ]
    },
    "StatusRules": {
      "type": "object",
      "properties": {
        "blocked_precondition": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "complete": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "insufficient_evidence": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "optional_unavailable": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "threshold_failure": {
          "$ref": "#/$defs/EvaluationStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "complete",
        "threshold_failure",
        "insufficient_evidence",
        "blocked_precondition",
        "optional_unavailable"
      ]
    },
    "TimeInterval": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/PhaseBoundary"
        },
        "start": {
          "$ref": "#/$defs/PhaseBoundary"
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "TimingDefinition": {
      "type": "object",
      "properties": {
        "duration_mode": {
          "$ref": "#/$defs/DurationMode"
        },
        "lead_in_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "settle_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "lead_in_ms",
        "settle_ms",
        "duration_mode"
      ]
    }
  }
}
