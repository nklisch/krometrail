{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "type": "object",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactIdentity"
    },
    "benchmark_definition": {
      "$ref": "#/$defs/RevisionIdentity"
    },
    "benchmark_id": {
      "type": "string"
    },
    "browser": {
      "$ref": "#/$defs/BrowserAvailability"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentIdentity"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture": {
      "$ref": "#/$defs/ManifestFixture"
    },
    "harness": {
      "$ref": "#/$defs/RevisionIdentity"
    },
    "kind": {
      "type": "string"
    },
    "krometrail": {
      "$ref": "#/$defs/KrometrailIdentity"
    },
    "model": {
      "$ref": "#/$defs/ModelAvailability"
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "$ref": "#/$defs/ManifestPrompt"
    },
    "qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveQualification"
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestRow"
      }
    },
    "run": {
      "$ref": "#/$defs/RunConfiguration"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "scorer": {
      "$ref": "#/$defs/ScorerIdentity"
    },
    "scoring": {
      "$ref": "#/$defs/ScoringIdentity"
    },
    "status": {
      "$ref": "#/$defs/EvaluationStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "benchmark_id",
    "benchmark_definition",
    "harness",
    "scorer",
    "fixture",
    "run",
    "environment",
    "browser",
    "krometrail",
    "model",
    "prompt",
    "artifact",
    "scoring",
    "rows",
    "status",
    "non_claims"
  ],
  "$defs": {
    "AcceptedClaim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "claim_id",
        "evidence_ids"
      ]
    },
    "Architecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64",
        "other"
      ]
    },
    "ArtifactIdentity": {
      "type": "object",
      "properties": {
        "algorithm_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedVersion"
          }
        },
        "condition_id": {
          "$ref": "#/$defs/ConditionId"
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputIdentity"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source_frame_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputIdentity"
          }
        },
        "source_interval_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "condition_id",
        "algorithm_versions",
        "parameters",
        "source_interval_id",
        "output_ids",
        "source_frame_ids",
        "gap_ids"
      ]
    },
    "BrowserAvailability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "not_required"
            }
          },
          "additionalProperties": false,
          "required": [
            "availability"
          ]
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "observed"
            },
            "capability_id": {
              "type": "string"
            },
            "product": {
              "$ref": "#/$defs/BrowserProduct"
            },
            "product_version": {
              "type": "string"
            },
            "protocol_version": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "availability",
            "product",
            "product_version",
            "protocol_version",
            "revision",
            "capability_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "type": "string"
            },
            "recovery": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "availability",
            "reason",
            "recovery"
          ]
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "blocked"
            },
            "reason": {
              "type": "string"
            },
            "recovery": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "availability",
            "reason",
            "recovery"
          ]
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "skipped"
            },
            "product": {
              "$ref": "#/$defs/BrowserProduct"
            },
            "reason": {
              "type": "string"
            },
            "recovery": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "availability",
            "product",
            "reason",
            "recovery"
          ]
        }
      ]
    },
    "BrowserProduct": {
      "type": "string",
      "enum": [
        "chromium",
        "chrome",
        "other_chromium"
      ]
    },
    "CacheDisposition": {
      "type": "string",
      "enum": [
        "cold",
        "warm",
        "unavailable"
      ]
    },
    "CaptureConfigIdentity": {
      "type": "object",
      "properties": {
        "ack_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_active_streams": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "queue_capacity": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "shutdown_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "queue_capacity",
        "max_active_streams",
        "ack_timeout_ms",
        "shutdown_timeout_ms"
      ]
    },
    "CaptureOrdinalRange": {
      "type": "object",
      "properties": {
        "first": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "last": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "first",
        "last"
      ]
    },
    "CaptureQualificationMeasurements": {
      "type": "object",
      "properties": {
        "gap_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_device_scale_factor": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "observed_frame_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "observed_viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "per_duration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DurationQualificationMeasurement"
          }
        },
        "repetitions": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "requested_durations_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "source_frame_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_time_sample_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "requested_durations_ms",
        "repetitions",
        "observed_viewport",
        "observed_device_scale_factor",
        "source_frame_count",
        "observed_frame_count",
        "source_time_sample_count",
        "gap_ids",
        "gap_count",
        "per_duration"
      ]
    },
    "CaseFamily": {
      "type": "string",
      "enum": [
        "movement_reversal",
        "flicker",
        "transient_layout",
        "dom_opaque_motion",
        "stable_control"
      ]
    },
    "CleanupQualificationMeasurements": {
      "type": "object",
      "properties": {
        "lock_released": {
          "type": "boolean"
        },
        "output_finalized": {
          "type": "boolean"
        },
        "profile_deleted": {
          "type": "boolean"
        },
        "remaining_managed_resources": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "server_stopped": {
          "type": "boolean"
        },
        "store_flushed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "server_stopped",
        "profile_deleted",
        "store_flushed",
        "lock_released",
        "output_finalized",
        "remaining_managed_resources"
      ]
    },
    "ConditionId": {
      "type": "string",
      "enum": [
        "A-final-screenshot",
        "B-uniform-storyboard",
        "C-change-aware-storyboard",
        "D-temporal-bundle",
        "E-progressive-source"
      ]
    },
    "ControlQualificationMeasurements": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "failed_observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenario_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_rate_basis_points": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "successes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "scenario_ids",
        "attempts",
        "successes",
        "failed_observation_ids",
        "success_rate_basis_points"
      ]
    },
    "DurationQualificationMeasurement": {
      "type": "object",
      "properties": {
        "coverage_rate_basis_points": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "eligibility_rate_basis_points": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "eligible_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "observed_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/EvaluationStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "eligible_count",
        "observed_count",
        "eligibility_rate_basis_points",
        "coverage_rate_basis_points",
        "status"
      ]
    },
    "EnvironmentIdentity": {
      "type": "object",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/Architecture"
        },
        "os_release_class": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        }
      },
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "os_release_class"
      ]
    },
    "EvaluationStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "blocked",
        "skipped"
      ]
    },
    "EvidenceAvailability": {
      "type": "string",
      "enum": [
        "retained",
        "evicted",
        "not_collected",
        "corrupt",
        "gap"
      ]
    },
    "FailureRecord": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/RunFailureCode"
        },
        "phase": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "phase",
        "reason",
        "recovery",
        "retryable"
      ]
    },
    "FixtureFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    },
    "ImageFormat": {
      "type": "string",
      "enum": [
        "png",
        "jpeg"
      ]
    },
    "KrometrailIdentity": {
      "type": "object",
      "properties": {
        "adapter_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedVersion"
          }
        },
        "capture_config": {
          "$ref": "#/$defs/CaptureConfigIdentity"
        },
        "cargo_lock_sha256": {
          "type": "string"
        },
        "git_revision": {
          "type": "string"
        },
        "rust_toolchain": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "git_revision",
        "cargo_lock_sha256",
        "rust_toolchain",
        "capture_config",
        "adapter_versions"
      ]
    },
    "LatencyQualificationMeasurements": {
      "type": "object",
      "properties": {
        "artifact_elapsed_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "frame_height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "frame_width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_interval_id": {
          "type": "string"
        },
        "temporal_query_elapsed_ms": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "threshold_profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        },
        "warm_cache": {
          "$ref": "#/$defs/CacheDisposition"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_interval_id",
        "viewport",
        "frame_width",
        "frame_height",
        "warm_cache",
        "temporal_query_elapsed_ms",
        "artifact_elapsed_ms",
        "sample_count",
        "threshold_profile_ids"
      ]
    },
    "LiveQualification": {
      "type": "object",
      "properties": {
        "capture": {
          "$ref": "#/$defs/CaptureQualificationMeasurements"
        },
        "cleanup": {
          "$ref": "#/$defs/CleanupQualificationMeasurements"
        },
        "control": {
          "$ref": "#/$defs/ControlQualificationMeasurements"
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualificationGateResult"
          }
        },
        "latency": {
          "$ref": "#/$defs/LatencyQualificationMeasurements"
        },
        "profile": {
          "type": "string"
        },
        "recovery": {
          "$ref": "#/$defs/RecoveryQualificationMeasurements"
        },
        "resources": {
          "$ref": "#/$defs/ResourceQualificationMeasurements"
        },
        "retention": {
          "$ref": "#/$defs/RetentionQualificationMeasurements"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "gates",
        "capture",
        "control",
        "retention",
        "recovery",
        "resources",
        "latency",
        "cleanup"
      ]
    },
    "ManifestFixture": {
      "type": "object",
      "properties": {
        "definition_sha256": {
          "type": "string"
        },
        "ordered_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureFile"
          }
        },
        "root_relative_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "root_relative_path",
        "ordered_files",
        "definition_sha256"
      ]
    },
    "ManifestPrompt": {
      "type": "object",
      "properties": {
        "prompt_set_id": {
          "$ref": "#/$defs/PromptId"
        },
        "prompt_version": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "task_prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt_set_id",
        "prompt_version",
        "system_prompt",
        "task_prompt",
        "sha256"
      ]
    },
    "ManifestRow": {
      "type": "object",
      "properties": {
        "accepted_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptedClaim"
          }
        },
        "answer_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capture_ordinal_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureOrdinalRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "type": "string"
        },
        "condition_id": {
          "$ref": "#/$defs/ConditionId"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "$ref": "#/$defs/CaseFamily"
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRangeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_answer_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "repetition": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "retention_state": {
          "$ref": "#/$defs/RetentionState"
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "scoring_rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRangeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRangeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "trial_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "trial_id",
        "case_id",
        "family",
        "duration_ms",
        "repetition",
        "condition_id",
        "gap_ids",
        "retention_state",
        "artifact_ids",
        "accepted_claims",
        "status"
      ]
    },
    "MatrixOrder": {
      "type": "string",
      "enum": [
        "family_case_duration_repetition",
        "seeded_fisher_yates"
      ]
    },
    "ModelAvailability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "not_required"
            }
          },
          "additionalProperties": false,
          "required": [
            "availability"
          ]
        },
        {
          "type": "object",
          "properties": {
            "authorization_ref": {
              "type": "string"
            },
            "availability": {
              "type": "string",
              "const": "observed"
            },
            "input_limits": {
              "$ref": "#/$defs/ModelInputLimits"
            },
            "invocation_date": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "model_version_or_dated_alias": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "availability",
            "provider",
            "model_id",
            "model_version_or_dated_alias",
            "invocation_date",
            "authorization_ref",
            "tools",
            "input_limits"
          ]
        },
        {
