#!/bin/sh
# Package-owned Krometrail launcher. stdout is reserved for the MCP child.
set -eu

PLUGIN_ROOT=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)
VERSION_FILE="$PLUGIN_ROOT/version"
INSTALLER="$PLUGIN_ROOT/scripts/install-managed.sh"

[ -f "$VERSION_FILE" ] || {
  printf 'krometrail plugin error: missing version marker\n' >&2
  exit 1
}
EXPECTED_VERSION=$(cat "$VERSION_FILE")
printf '%s\n' "$EXPECTED_VERSION" | awk '
  length($0) <= 64 && $0 ~ /^[0-9]+[.][0-9]+[.][0-9]+$/ { valid=1 }
  END { exit(valid ? 0 : 1) }
' || {
  printf 'krometrail plugin error: invalid version marker\n' >&2
  exit 1
}

if [ -n "${KROMETRAIL_MANAGED_ROOT:-}" ]; then
  MANAGED_ROOT=$KROMETRAIL_MANAGED_ROOT
  MANAGED_ROOT_SOURCE=KROMETRAIL_MANAGED_ROOT
elif [ -n "${PLUGIN_DATA:-}" ]; then
  MANAGED_ROOT=$PLUGIN_DATA
  MANAGED_ROOT_SOURCE=PLUGIN_DATA
elif [ -n "${CLAUDE_PLUGIN_DATA:-}" ]; then
  MANAGED_ROOT=$CLAUDE_PLUGIN_DATA
  MANAGED_ROOT_SOURCE=CLAUDE_PLUGIN_DATA
elif [ -n "${XDG_DATA_HOME:-}" ]; then
  MANAGED_ROOT=$XDG_DATA_HOME/krometrail/plugin
  MANAGED_ROOT_SOURCE=XDG_DATA_HOME
else
  : "${HOME:?HOME is required when no plugin data directory is available}"
  MANAGED_ROOT=$HOME/.local/share/krometrail/plugin
  MANAGED_ROOT_SOURCE=HOME
fi

case "$MANAGED_ROOT" in
  /*) ;;
  *)
    printf 'krometrail plugin error: managed data path must be absolute\n' >&2
    exit 1
    ;;
esac

printf 'krometrail plugin: expected v%s; managed root %s (source: %s)\n' \
  "$EXPECTED_VERSION" "$MANAGED_ROOT" "$MANAGED_ROOT_SOURCE" >&2

MANAGED_BINARY="$MANAGED_ROOT/versions/$EXPECTED_VERSION/krometrail"

[ -x "$INSTALLER" ] || {
  printf 'krometrail plugin error: managed installer is missing or not executable\n' >&2
  exit 1
}

VERIFY_FAILURE_REASON=
managed_binary_is_current() {
  VERIFY_FAILURE_REASON=$(
    "$INSTALLER" "$EXPECTED_VERSION" "$MANAGED_ROOT" verify-existing 2>&1 >/dev/null
  ) && return 0
  [ -n "$VERIFY_FAILURE_REASON" ] || VERIFY_FAILURE_REASON="verify-existing failed without a diagnostic"
  return 1
}

LOCK_FILE="$MANAGED_ROOT/.install-lock"
INSTALL_STATUS="$MANAGED_ROOT/.install-status.$$"
LOCK_OWNER=0

# The lock is one owner-pid file created atomically with noclobber, so there
# is never a window where the lock exists without its owner recorded.
# OBSERVED_LOCK_PID carries the content each liveness probe read so stale
# reclaim can verify it is removing the owner it actually observed dead.
OBSERVED_LOCK_PID=
lock_owner_is_alive() {
  OBSERVED_LOCK_PID=$(cat "$LOCK_FILE" 2>/dev/null) || OBSERVED_LOCK_PID=
  case "$OBSERVED_LOCK_PID" in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$OBSERVED_LOCK_PID" 2>/dev/null
}

reclaim_stale_lock() {
  observed_dead_pid="$1"
  stale_lock="$LOCK_FILE.stale.$$"
  mv "$LOCK_FILE" "$stale_lock" 2>/dev/null || return 1
  stolen_pid=$(cat "$stale_lock" 2>/dev/null) || stolen_pid=
  if [ "$stolen_pid" = "$observed_dead_pid" ]; then
    rm -rf "$stale_lock"
    return 0
  fi
  # The lock changed hands between the dead observation and the steal; give
  # it back unless a newer lock already exists, then re-enter the wait loop.
  if [ ! -e "$LOCK_FILE" ]; then
    mv "$stale_lock" "$LOCK_FILE" 2>/dev/null || rm -rf "$stale_lock"
  else
    rm -rf "$stale_lock"
  fi
  return 1
}

acquire_install_lock() {
  elapsed=0
  not_alive=0
  last_observed=
  while :; do
    if (set -C; printf '%s\n' "$$" >"$LOCK_FILE") 2>/dev/null; then
      LOCK_OWNER=1
      # Only dead owners can leave status files behind; the live installer's
      # own status path is created after this point.
      rm -f "$MANAGED_ROOT"/.install-status.* 2>/dev/null || true
      return 0
    fi
    if lock_owner_is_alive; then
      not_alive=0
    else
      # Require two spaced observations of the SAME dead owner before
      # reclaiming so a peer that just created the lock, a garbled read, or a
      # handoff in flight is never treated as dead.
      if [ "$OBSERVED_LOCK_PID" = "$last_observed" ]; then
        not_alive=$((not_alive + 1))
      else
        not_alive=1
      fi
      if [ "$not_alive" -ge 2 ]; then
        reclaim_stale_lock "$OBSERVED_LOCK_PID" && continue
        not_alive=0
      fi
    fi
    last_observed="$OBSERVED_LOCK_PID"
    if [ "$elapsed" -ge 20 ]; then
      return 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
}

# Remove the lock only while it still records a pid this launcher installed
# there; a lock reclaimed and re-owned by a peer is never deleted from here.
release_install_lock() {
  if [ "$LOCK_OWNER" -eq 1 ]; then
    current_owner=$(cat "$LOCK_FILE" 2>/dev/null) || current_owner=
    case "$current_owner" in
      "$$"|"${INSTALL_PID:-}") rm -f "$LOCK_FILE" ;;
    esac
    LOCK_OWNER=0
  fi
}

if ! managed_binary_is_current; then
  printf 'krometrail plugin: reinstalling because: %s\n' "$VERIFY_FAILURE_REASON" >&2
  printf 'krometrail plugin: installing managed release v%s\n' "$EXPECTED_VERSION" >&2

  # The installer performs the authoritative path validation. This creates only
  # the expected root needed for the portable lock file; an unsafe root remains
  # rejected by the installer before any binary can be executed.
  mkdir -p "$MANAGED_ROOT" 2>/dev/null || true
  if [ -L "$MANAGED_ROOT" ]; then
    LOCK_OWNER=0
  elif ! acquire_install_lock; then
    printf 'krometrail plugin: managed release install is still running in the background; reconnect to retry\n' >&2
    exit 1
  fi

  if [ "$LOCK_OWNER" -eq 1 ] && managed_binary_is_current; then
    release_install_lock
  elif [ "$LOCK_OWNER" -eq 1 ]; then
    rm -f "$INSTALL_STATUS"
    (
      set +e
      "$INSTALLER" "$EXPECTED_VERSION" "$MANAGED_ROOT"
      install_status=$?
      printf '%s\n' "$install_status" >"$INSTALL_STATUS"
      exit "$install_status"
    ) &
    INSTALL_PID=$!
    # Hand lock ownership to the installer so a launcher that exits at the
    # connect budget leaves waiting peers fenced on the live install. The
    # write lands via atomic rename so no peer can observe a truncated lock.
    handoff="$LOCK_FILE.handoff.$$"
    if printf '%s\n' "$INSTALL_PID" >"$handoff" 2>/dev/null; then
      mv -f "$handoff" "$LOCK_FILE" 2>/dev/null || rm -f "$handoff"
    fi
    elapsed=0
    while [ ! -f "$INSTALL_STATUS" ]; do
      if [ "$elapsed" -ge 20 ]; then
        printf 'krometrail plugin: managed release install is still running in the background; reconnect to retry\n' >&2
        exit 1
      fi
      sleep 1
      elapsed=$((elapsed + 1))
    done
    install_status=$(cat "$INSTALL_STATUS")
    wait "$INSTALL_PID" 2>/dev/null || true
    rm -f "$INSTALL_STATUS"
    release_install_lock
    [ "$install_status" -eq 0 ] || exit 1
  fi
fi

managed_binary_is_current || {
  printf 'krometrail plugin error: managed release v%s is unavailable after installation: %s\n' \
    "$EXPECTED_VERSION" "$VERIFY_FAILURE_REASON" >&2
  exit 1
}

exec "$MANAGED_BINARY" "$@"
